{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xonar-se-open-driver/configs/profiles/control-v1.schema.json",
  "title": "IPC de contrôle Xonar SE v1",
  "description": "Messages du named pipe C4 (requête, réponse, notification) et commandes éphémères de test de canal. Généré depuis contracts/manifest.json ; ne pas éditer.",
  "$comment": "Généré par contracts/generate.py depuis contracts/manifest.json (sha256 45fee5376e713c752dbf22bec73fca519f555bbcf341fce018e6d997e3a032a8). Ne pas éditer.",
  "oneOf": [
    {
      "$ref": "#/$defs/ControlRequest"
    },
    {
      "$ref": "#/$defs/ControlResponse"
    },
    {
      "$ref": "#/$defs/StateNotification"
    }
  ],
  "$defs": {
    "ControlRequest": {
      "description": "Requête IPC centre → agent.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiMajor",
        "apiMinor",
        "requestId",
        "endpointKey",
        "command",
        "payload"
      ],
      "properties": {
        "apiMajor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "const": 1
        },
        "apiMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "endpointKey": {
          "description": "Clé opaque ; null admis seulement pour une commande de portée agent.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[!-~]{1,256}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expectedRevision": {
          "description": "Dernière révision connue ; obligatoire pour toute écriture.",
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "command": {
          "$ref": "#/$defs/Command"
        },
        "payload": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "command": {
                "enum": [
                  "GetState",
                  "ValidateProfile",
                  "ApplyProfile",
                  "SubscribeState",
                  "SetHardwareVolume",
                  "StartChannelTest",
                  "StopChannelTest",
                  "RequestFormatRepair"
                ]
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "properties": {
              "endpointKey": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "enum": [
                  "ApplyProfile",
                  "SetHardwareVolume",
                  "RequestFormatRepair"
                ]
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "required": [
              "expectedRevision"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "GetCapabilities"
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/EmptyPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "GetState"
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/EmptyPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "ValidateProfile"
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/UncheckedProfilePayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "ApplyProfile"
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/ProfilePayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "SubscribeState"
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/SubscribeStatePayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "SetHardwareVolume"
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/HardwareVolumePayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "StartChannelTest"
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/StartChannelTestPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "StopChannelTest"
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/StopChannelTestPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "RequestFormatRepair"
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/EmptyPayload"
              }
            }
          }
        }
      ]
    },
    "Command": {
      "description": "Commandes IPC centre ↔ agent.",
      "type": "string",
      "enum": [
        "GetCapabilities",
        "GetState",
        "ValidateProfile",
        "ApplyProfile",
        "SubscribeState",
        "SetHardwareVolume",
        "StartChannelTest",
        "StopChannelTest",
        "RequestFormatRepair"
      ]
    },
    "EmptyPayload": {
      "description": "Charge utile vide.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "UncheckedProfilePayload": {
      "description": "[D] Charge utile de ValidateProfile : objet JSON quelconque, validé par l'agent qui renvoie tous les diagnostics dans ValidationResult.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile"
      ],
      "properties": {
        "profile": {
          "description": "Document JSON brut (objet), non validé par l'enveloppe.",
          "type": "object"
        }
      }
    },
    "ProfilePayload": {
      "description": "Charge utile d'ApplyProfile : profil v1 valide exigé dès l'enveloppe.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/ProfileDocument"
        }
      }
    },
    "ProfileDocument": {
      "description": "Document de profil v1 : bibliothèque, import/export et charge utile CAPX. Pas de sampleRate, de masque, de ChannelTest, de chemin ni de commande noyau.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "profileId",
        "revision",
        "endpointRole",
        "listeningMode",
        "sourcePolicy",
        "routing",
        "output"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "const": 1
        },
        "profileId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "description": "Révision du document, croissante, ≥ 1.",
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "endpointRole": {
          "$ref": "#/$defs/EndpointRole"
        },
        "listeningMode": {
          "$ref": "#/$defs/ListeningMode"
        },
        "sourcePolicy": {
          "$ref": "#/$defs/SourcePolicy"
        },
        "routing": {
          "$ref": "#/$defs/RoutingSettings"
        },
        "output": {
          "$ref": "#/$defs/OutputSettings"
        }
      }
    },
    "EndpointRole": {
      "description": "Rôle d'endpoint ; v1 : haut-parleurs seulement.",
      "type": "string",
      "enum": [
        "speakers"
      ]
    },
    "ListeningMode": {
      "description": "Mode de sortie persistant. Sortie Windows toujours 6 canaux / 0x60F.",
      "type": "string",
      "enum": [
        "5.1",
        "upmix",
        "2.1",
        "2.0"
      ]
    },
    "SourcePolicy": {
      "description": "Politique par flux négocié demandée par le profil.",
      "type": "string",
      "enum": [
        "preserve",
        "autoDeclaredLayout",
        "forceStereoFrontPair"
      ]
    },
    "RoutingSettings": {
      "description": "Paramètres du RoutingStage SFX (matrice + dérivation LFE).",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "upmix": {
          "$ref": "#/$defs/UpmixSettings"
        }
      }
    },
    "UpmixSettings": {
      "description": "Upmix 2→6 du SFX.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "centerGainDb": {
          "type": "number",
          "minimum": -30,
          "maximum": 0,
          "default": -3
        },
        "surroundGainDb": {
          "type": "number",
          "minimum": -30,
          "maximum": 0,
          "default": -6
        },
        "deriveLfe": {
          "type": "boolean",
          "default": true
        },
        "lfeGainDb": {
          "type": "number",
          "minimum": -30,
          "maximum": 0,
          "default": -6
        },
        "lfeLowPassHz": {
          "description": "Dérivation upmix 40…250 Hz.",
          "type": "number",
          "minimum": 40,
          "maximum": 250,
          "default": 120
        }
      }
    },
    "OutputSettings": {
      "description": "Compensation de sortie EFX ; groupes absents normalisés aux défauts C++.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "masterGainDb": {
          "type": "number",
          "minimum": -60,
          "maximum": 6,
          "default": 0
        },
        "channelGainDb": {
          "description": "Trims indexés par Channel (FL FR FC LFE BL BR SL SR).",
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -60,
            "maximum": 12
          },
          "minItems": 8,
          "maxItems": 8,
          "default": [
            0,
            0,
            0,
            0,
            0,
            0,
            0,
            0
          ]
        },
        "channelDelayMs": {
          "description": "Délais 0…50 ms, chacun ≤ maxDelayMs.",
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 50
          },
          "minItems": 8,
          "maxItems": 8,
          "default": [
            0,
            0,
            0,
            0,
            0,
            0,
            0,
            0
          ]
        },
        "channelMute": {
          "type": "array",
          "items": {
            "type": "boolean"
          },
          "minItems": 8,
          "maxItems": 8,
          "default": [
            false,
            false,
            false,
            false,
            false,
            false,
            false,
            false
          ]
        },
        "eq": {
          "description": "eq[8][10] indexé par Channel.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/EqBand"
            },
            "minItems": 10,
            "maxItems": 10
          },
          "minItems": 8,
          "maxItems": 8
        },
        "downmix": {
          "$ref": "#/$defs/DownmixSettings"
        },
        "twoPointOne": {
          "$ref": "#/$defs/TwoPointOneSettings"
        },
        "bassManagement": {
          "$ref": "#/$defs/BassManagementSettings"
        },
        "limiter": {
          "$ref": "#/$defs/LimiterSettings"
        },
        "gainRampMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 20
        },
        "maxDelayMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 50,
          "default": 50
        }
      }
    },
    "EqBand": {
      "description": "Bande EQ peaking.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "frequencyHz": {
          "description": "10…20 000 Hz et strictement sous Nyquist de la connexion.",
          "type": "number",
          "minimum": 10,
          "maximum": 20000,
          "default": 1000
        },
        "q": {
          "type": "number",
          "maximum": 20,
          "exclusiveMinimum": 0,
          "default": 1
        },
        "gainDb": {
          "type": "number",
          "minimum": -24,
          "maximum": 12,
          "default": 0
        }
      }
    },
    "DownmixSettings": {
      "description": "Downmix 5.1 → 2.0 (ITU-R BS.775).",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "centerGainDb": {
          "type": "number",
          "minimum": -30,
          "maximum": 0,
          "default": -3
        },
        "surroundGainDb": {
          "type": "number",
          "minimum": -30,
          "maximum": 0,
          "default": -3
        },
        "includeLfe": {
          "type": "boolean",
          "default": false
        },
        "lfeGainDb": {
          "type": "number",
          "minimum": -30,
          "maximum": 0,
          "default": -6
        },
        "headroomDb": {
          "type": "number",
          "minimum": -12,
          "maximum": 0,
          "default": -4.5
        }
      }
    },
    "TwoPointOneSettings": {
      "description": "2.1 virtuel sur la sortie 5.1.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "lfeGainDb": {
          "type": "number",
          "minimum": -30,
          "maximum": 6,
          "default": 0
        },
        "lfeLowPassHz": {
          "type": "number",
          "minimum": 40,
          "maximum": 200,
          "default": 80
        },
        "includeSourceLfe": {
          "type": "boolean",
          "default": true
        },
        "sourceLfeGainDb": {
          "type": "number",
          "minimum": -30,
          "maximum": 6,
          "default": 0
        }
      }
    },
    "BassManagementSettings": {
      "description": "Bass management de l'EFX.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "crossoverHz": {
          "type": "number",
          "minimum": 40,
          "maximum": 200,
          "default": 80
        },
        "highPassSatellites": {
          "type": "boolean",
          "default": true
        },
        "sumToLfe": {
          "type": "boolean",
          "default": true
        },
        "sumToLfeGainDb": {
          "type": "number",
          "minimum": -20,
          "maximum": 6,
          "default": 0
        }
      }
    },
    "LimiterSettings": {
      "description": "Limiteur crête de l'EFX.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "ceilingDb": {
          "type": "number",
          "minimum": -12,
          "maximum": 0,
          "default": -0.3
        },
        "releaseMs": {
          "type": "number",
          "minimum": 5,
          "maximum": 1000,
          "default": 80
        }
      }
    },
    "SubscribeStatePayload": {
      "description": "Abonnement à l'état, rafraîchissement ≤ 20 Hz.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "maxRateHz": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 20
        }
      }
    },
    "HardwareVolumePayload": {
      "description": "Charge utile de SetHardwareVolume.",
      "oneOf": [
        {
          "$ref": "#/$defs/VolumeLevelControl"
        },
        {
          "$ref": "#/$defs/MuteControl"
        }
      ]
    },
    "VolumeLevelControl": {
      "description": "Volume matériel d'un canal KS haut-parleurs ; bornes réelles par BASICSUPPORT.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "ksChannel",
        "levelDb"
      ],
      "properties": {
        "control": {
          "const": "volume"
        },
        "ksChannel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "levelDb": {
          "type": "number",
          "minimum": -32768,
          "exclusiveMaximum": 32768
        }
      }
    },
    "HardwareControl": {
      "description": "Discriminant de SetHardwareVolume.",
      "type": "string",
      "enum": [
        "volume",
        "mute"
      ]
    },
    "MuteControl": {
      "description": "Mute maître matériel (canal UAC2 0).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "mute"
      ],
      "properties": {
        "control": {
          "const": "mute"
        },
        "mute": {
          "type": "boolean"
        }
      }
    },
    "StartChannelTestPayload": {
      "description": "Démarrage ou renouvellement d'un test de canal éphémère.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testId",
        "channelBit",
        "frequencyHz",
        "levelDb"
      ],
      "properties": {
        "testId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "channelBit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "enum": [
            1,
            2,
            4,
            8,
            512,
            1024
          ]
        },
        "frequencyHz": {
          "type": "number",
          "minimum": 20,
          "maximum": 20000
        },
        "levelDb": {
          "type": "number",
          "minimum": -60,
          "maximum": -20
        }
      }
    },
    "StopChannelTestPayload": {
      "description": "Arrêt explicite d'un test de canal.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testId"
      ],
      "properties": {
        "testId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    },
    "ControlResponse": {
      "description": "Réponse IPC agent → centre. Export JSON réussi ≠ profil appliqué.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "status",
        "revision",
        "desiredGeneration",
        "committedGeneration",
        "appliedInstances",
        "error"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "status": {
          "$ref": "#/$defs/ResponseStatus"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "desiredGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "committedGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "appliedInstances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InstanceGeneration"
          },
          "maxItems": 64
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "description": "[D] Ajout nécessaire à GetState/GetCapabilities/ValidateProfile ; absent ou null sinon.",
          "anyOf": [
            {
              "$ref": "#/$defs/ControlResult"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "Error"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "error": {
                "not": {
                  "type": "null"
                }
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "Error"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "ResponseStatus": {
      "description": "[D] Statut de réponse : validé/lu, écrit dans CAPX, appliqué par toutes les instances, ou erreur.",
      "type": "string",
      "enum": [
        "Ok",
        "Committed",
        "Applied",
        "Error"
      ]
    },
    "InstanceGeneration": {
      "description": "Génération appliquée par une instance APO.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceId",
        "stage",
        "appliedGeneration"
      ],
      "properties": {
        "instanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:{}-]{1,128}$"
        },
        "stage": {
          "$ref": "#/$defs/ApoStage"
        },
        "appliedGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    },
    "ApoStage": {
      "description": "Étage APO : SFX par flux avant mixage, EFX après mixage.",
      "type": "string",
      "enum": [
        "SFX",
        "EFX"
      ]
    },
    "ErrorInfo": {
      "description": "Erreur stable.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "path"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "path": {
          "description": "Pointeur JSON du champ fautif, si applicable.",
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ErrorCode": {
      "description": "Erreurs stables de l'IPC.",
      "type": "string",
      "enum": [
        "InvalidProfile",
        "RevisionConflict",
        "UnsupportedCapability",
        "EndpointUnavailable",
        "Busy",
        "AccessDenied",
        "RestartRequired",
        "TimedOut"
      ]
    },
    "ControlResult": {
      "description": "Résultat typé d'une réponse.",
      "oneOf": [
        {
          "$ref": "#/$defs/CapabilitiesResult"
        },
        {
          "$ref": "#/$defs/StateResult"
        },
        {
          "$ref": "#/$defs/ValidationResult"
        },
        {
          "$ref": "#/$defs/HardwareVolumeResult"
        },
        {
          "$ref": "#/$defs/ChannelTestResult"
        }
      ]
    },
    "CapabilitiesResult": {
      "description": "Résultat de GetCapabilities.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "apiMajor",
        "apiMinor",
        "contracts",
        "endpoints",
        "features"
      ],
      "properties": {
        "kind": {
          "const": "capabilities"
        },
        "apiMajor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "const": 1
        },
        "apiMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContractVersionInfo"
          },
          "minItems": 8,
          "maxItems": 8
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EndpointCapability"
          },
          "maxItems": 16
        },
        "features": {
          "$ref": "#/$defs/FeatureFlags"
        }
      }
    },
    "ResultKind": {
      "description": "Discriminant du champ result d'une réponse.",
      "type": "string",
      "enum": [
        "capabilities",
        "state",
        "validation",
        "hardwareVolume",
        "channelTest"
      ]
    },
    "ContractVersionInfo": {
      "description": "Version d'un contrat.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "major",
        "minor"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^C[1-8]$"
        },
        "major": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "EndpointCapability": {
      "description": "Endpoint identifié par MI_00, VID/PID et rôle. writable=false sans correspondance unique.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpointKey",
        "endpointRole",
        "driver",
        "supportedSampleRates",
        "physicalChannelMask",
        "writable"
      ],
      "properties": {
        "endpointKey": {
          "type": "string",
          "pattern": "^[!-~]{1,256}$"
        },
        "endpointRole": {
          "$ref": "#/$defs/EndpointRole"
        },
        "driver": {
          "$ref": "#/$defs/DriverInfo"
        },
        "supportedSampleRates": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "enum": [
              44100,
              48000,
              96000,
              192000
            ]
          },
          "maxItems": 4,
          "uniqueItems": true
        },
        "physicalChannelMask": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "const": 1551
        },
        "writable": {
          "type": "boolean"
        }
      }
    },
    "DriverInfo": {
      "description": "Pilote observé ; version et empreinte nulles si inconnues.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "packageSha256"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/DriverKind"
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{1,5}\\.[0-9]{1,5}\\.[0-9]{1,5}\\.[0-9]{1,5}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "packageSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "DriverKind": {
      "description": "Pilote noyau observé pour l'endpoint.",
      "type": "string",
      "enum": [
        "xonarse",
        "usbaudio2",
        "unknown"
      ]
    },
    "FeatureFlags": {
      "description": "Capacités activées après preuve (E0-03, E0-04).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "autoDeclaredLayout",
        "channelTest",
        "formatRepair"
      ],
      "properties": {
        "autoDeclaredLayout": {
          "type": "boolean"
        },
        "channelTest": {
          "type": "boolean"
        },
        "formatRepair": {
          "type": "boolean"
        }
      }
    },
    "StateResult": {
      "description": "Résultat de GetState.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "state"
      ],
      "properties": {
        "kind": {
          "const": "state"
        },
        "state": {
          "$ref": "#/$defs/AgentState"
        }
      }
    },
    "AgentState": {
      "description": "État versionné de l'agent pour un endpoint.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "endpointKey",
        "endpointRole",
        "revision",
        "driver",
        "negotiatedFormat",
        "profileId",
        "listeningMode",
        "requestedPolicy",
        "resolvedPolicy",
        "desiredGeneration",
        "committedGeneration",
        "partiallyApplied",
        "instances",
        "jack",
        "meters"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "const": 1
        },
        "endpointKey": {
          "type": "string",
          "pattern": "^[!-~]{1,256}$"
        },
        "endpointRole": {
          "$ref": "#/$defs/EndpointRole"
        },
        "revision": {
          "description": "Révision de configuration de l'endpoint ; 0 = jamais écrite.",
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "driver": {
          "$ref": "#/$defs/DriverInfo"
        },
        "negotiatedFormat": {
          "anyOf": [
            {
              "$ref": "#/$defs/NegotiatedFormat"
            },
            {
              "type": "null"
            }
          ]
        },
        "profileId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "listeningMode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ListeningMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestedPolicy": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourcePolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolvedPolicy": {
          "$ref": "#/$defs/ResolvedPolicy"
        },
        "desiredGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "committedGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "partiallyApplied": {
          "type": "boolean"
        },
        "instances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ApoInstanceState"
          },
          "maxItems": 64
        },
        "jack": {
          "$ref": "#/$defs/JackState"
        },
        "meters": {
          "anyOf": [
            {
              "$ref": "#/$defs/MeterState"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "NegotiatedFormat": {
      "description": "Format réellement négocié d'une connexion.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleRate",
        "channelMask",
        "channelCount",
        "sampleFormat"
      ],
      "properties": {
        "sampleRate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 384000
        },
        "channelMask": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "enum": [
            3,
            63,
            1551
          ]
        },
        "channelCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "sampleFormat": {
          "$ref": "#/$defs/SampleFormat"
        }
      }
    },
    "SampleFormat": {
      "description": "[D] Format d'échantillon de la connexion négociée.",
      "type": "string",
      "enum": [
        "float32",
        "pcm16",
        "pcm24",
        "pcm32",
        "unknown"
      ]
    },
    "ResolvedPolicy": {
      "description": "Politique effectivement résolue, rapportée par l'agent.",
      "type": "string",
      "enum": [
        "preserve",
        "autoDeclaredLayout",
        "forceStereoFrontPair",
        "neutral",
        "conservative"
      ]
    },
    "ApoInstanceState": {
      "description": "Instance SFX/EFX active.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceId",
        "stage",
        "epoch",
        "appliedGeneration",
        "inputFormat",
        "bypass"
      ],
      "properties": {
        "instanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:{}-]{1,128}$"
        },
        "stage": {
          "$ref": "#/$defs/ApoStage"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "appliedGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "inputFormat": {
          "anyOf": [
            {
              "$ref": "#/$defs/NegotiatedFormat"
            },
            {
              "type": "null"
            }
          ]
        },
        "bypass": {
          "$ref": "#/$defs/BypassState"
        }
      }
    },
    "BypassState": {
      "description": "Motif de bypass observé ou inconnu.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/BypassKind"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/BypassReason"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "observed"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "none"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "BypassKind": {
      "description": "Motif de bypass : observé ou inconnu, jamais supposé.",
      "type": "string",
      "enum": [
        "none",
        "observed",
        "unknown"
      ]
    },
    "BypassReason": {
      "description": "[D] Motifs de bypass mesurés de la matrice C2.",
      "type": "string",
      "enum": [
        "exclusiveMode",
        "raw",
        "enhancementsDisabled",
        "offload",
        "drm",
        "iec61937",
        "formatUnsupported",
        "other"
      ]
    },
    "JackState": {
      "description": "État publié à Windows et sa fiabilité ; jamais une présence physique prouvée.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reliability",
        "publishedConnected"
      ],
      "properties": {
        "reliability": {
          "$ref": "#/$defs/JackReliability"
        },
        "publishedConnected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "JackReliability": {
      "description": "Fiabilité de l'état jack publié : sous HonorJackDetection=0, connecté ne prouve pas la présence physique.",
      "type": "string",
      "enum": [
        "reported",
        "forcedConnection",
        "unknown"
      ]
    },
    "MeterState": {
      "description": "Crêtes de sortie APO (≠ niveaux analogiques) et réduction du limiteur.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ageMs",
        "stale",
        "outputPeakDbfs",
        "limiterReductionDb",
        "nonFiniteFrames",
        "telemetryLost"
      ],
      "properties": {
        "ageMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "stale": {
          "type": "boolean"
        },
        "outputPeakDbfs": {
          "description": "Ordre physique FL FR FC LFE SL SR.",
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -200,
            "maximum": 40
          },
          "minItems": 6,
          "maxItems": 6
        },
        "limiterReductionDb": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "nonFiniteFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "telemetryLost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    },
    "ValidationResult": {
      "description": "Résultat de ValidateProfile ; validé ≠ appliqué.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "valid",
        "normalized",
        "diagnostics"
      ],
      "properties": {
        "kind": {
          "const": "validation"
        },
        "valid": {
          "type": "boolean"
        },
        "normalized": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProfileDocument"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "maxItems": 256
        }
      }
    },
    "Diagnostic": {
      "description": "Diagnostic de champ.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "path",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)*$"
        },
        "path": {
          "type": "string",
          "maxLength": 256
        },
        "message": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "HardwareVolumeResult": {
      "description": "Valeurs matérielles réellement relues après SetHardwareVolume.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ksChannel",
        "levelDb",
        "mute"
      ],
      "properties": {
        "kind": {
          "const": "hardwareVolume"
        },
        "ksChannel": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            {
              "type": "null"
            }
          ]
        },
        "levelDb": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -32768,
              "exclusiveMaximum": 32768
            },
            {
              "type": "null"
            }
          ]
        },
        "mute": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ChannelTestResult": {
      "description": "Acquittement d'un test de canal.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "testId",
        "expiresInMs"
      ],
      "properties": {
        "kind": {
          "const": "channelTest"
        },
        "testId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expiresInMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        }
      }
    },
    "StateNotification": {
      "description": "[D] Notification poussée après SubscribeState.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "sequence",
        "state"
      ],
      "properties": {
        "requestId": {
          "description": "requestId de l'abonnement.",
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "state": {
          "$ref": "#/$defs/AgentState"
        }
      }
    },
    "ChannelTestCommand": {
      "description": "Commande éphémère agent → APO, distincte du document CAPX.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch",
        "generation",
        "testId",
        "channelBit",
        "frequencyHz",
        "levelDb",
        "expiresQpc"
      ],
      "properties": {
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "testId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "channelBit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "enum": [
            1,
            2,
            4,
            8,
            512,
            1024
          ]
        },
        "frequencyHz": {
          "type": "number",
          "minimum": 20,
          "maximum": 20000
        },
        "levelDb": {
          "type": "number",
          "minimum": -60,
          "maximum": -20
        },
        "expiresQpc": {
          "description": "Compteur QPC monotone ; au plus 2 s après renouvellement.",
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    },
    "ChannelTestStop": {
      "description": "Arrêt explicite éphémère agent → APO.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch",
        "generation",
        "testId",
        "stop"
      ],
      "properties": {
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "testId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "stop": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
