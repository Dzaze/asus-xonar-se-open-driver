    { "id": "Q10", "category": "nyquist", "base": "PN", "set": { "/output/twoPointOne/lfeLowPassHz": 39 }, "expect": "schema.minimum", "doc": "Passe-bas 2.1 sous 40 Hz." },
    { "id": "Q11", "category": "nyquist", "base": "P", "context": { "sampleRate": 48000.0 }, "expect": "semantic.sampleRateRange", "doc": "Fréquence de contexte non entière." },

    { "id": "R01", "category": "revision", "base": "P", "set": { "/revision": 0 }, "expect": "schema.minimum", "doc": "Révision 0." },
    { "id": "R02", "category": "revision", "base": "P", "set": { "/revision": -1 }, "expect": "schema.minimum", "doc": "Révision négative." },
    { "id": "R03", "category": "revision", "base": "P", "set": { "/revision": 18446744073709551616 }, "expect": "schema.maximum", "doc": "Révision au-delà de uint64." },
    { "id": "R04", "category": "revision", "base": "P", "set": { "/revision": "1" }, "expect": "schema.type", "doc": "Révision en chaîne." },
    { "id": "R05", "category": "revision", "base": "P", "set": { "/revision": 1.5 }, "expect": "schema.type", "doc": "Révision non entière." },
    { "id": "R06", "category": "revision", "base": "RQA", "remove": ["/expectedRevision"], "expect": "schema.required", "expectPath": "/expectedRevision", "doc": "ApplyProfile sans révision attendue." },
    { "id": "R07", "category": "revision", "base": "RQV", "remove": ["/expectedRevision"], "expect": "schema.required", "expectPath": "/expectedRevision", "doc": "SetHardwareVolume sans révision attendue." },
    { "id": "R08", "category": "revision", "base": "RQA", "set": { "/expectedRevision": -1 }, "expect": "schema.minimum", "doc": "Révision attendue négative." },
    { "id": "R09", "category": "revision", "base": "CX", "set": { "/generation": 0 }, "expect": "schema.minimum", "doc": "Génération CAPX 0." },
