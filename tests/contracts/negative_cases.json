    { "id": "E03", "category": "enum", "base": "P", "set": { "/endpointRole": "headphones" }, "expect": "schema.enum", "doc": "Rôle non pris en charge en v1." },
    { "id": "E04", "category": "structure", "base": "P", "set": { "/extra": true }, "expect": "schema.additionalProperties", "doc": "Champ racine inconnu." },
