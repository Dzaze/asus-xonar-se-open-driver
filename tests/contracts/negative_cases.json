{
  "description": "Cas négatifs des contrats v1 (E0-02). Chaque cas part d'une fixture positive (base, valide sans contexte) ou d'un texte brut, applique une mutation et doit être refusé avec le code attendu. Format réutilisable par les tests C++/C# des consommateurs. Mutations : set/remove (pointeurs JSON, « - » ajoute en fin de tableau), replace (substitution textuelle exacte, une occurrence), raw, padTo (octets), prefixBom, invalidUtf8 ; valeur {\"$repeat\": [texte, n]} pour une chaîne longue.",
  "bases": {
    "P": "configs/examples/v1/profiles/exemple-section-1.4.json",
    "PN": "configs/examples/v1/normalized/exemple-section-1.4.json",
    "PF": "configs/examples/v1/profiles/eq-80-bandes.json",
    "CX": "configs/examples/v1/capx/efx-upmix.json",
    "RQA": "configs/examples/v1/control/requete-apply-profile.json",
    "RQS": "configs/examples/v1/control/requete-get-state.json",
    "RQT": "configs/examples/v1/control/requete-start-channel-test.json",
    "RQV": "configs/examples/v1/control/requete-set-volume.json",
    "RQB": "configs/examples/v1/control/requete-subscribe-state.json",
    "RSA": "configs/examples/v1/control/reponse-applied.json",
    "RSE": "configs/examples/v1/control/reponse-erreur-conflit-revision.json",
    "RSC": "configs/examples/v1/control/reponse-capabilities.json",
    "ST": "configs/examples/v1/state/converge.json",
    "CT": "configs/examples/v1/ephemeral/channel-test/lfe-60hz.json",
    "CS": "configs/examples/v1/ephemeral/channel-test-stop/arret.json",
    "TE": "configs/examples/v1/ephemeral/telemetry/efx-0.json"
  },
  "targets": {
    "P": "profile-v1", "PN": "profile-v1", "PF": "profile-v1", "CX": "profile-v1#CapxDocument",
    "RQA": "control-v1", "RQS": "control-v1", "RQT": "control-v1", "RQV": "control-v1", "RQB": "control-v1",
    "RSA": "control-v1", "RSE": "control-v1", "RSC": "control-v1", "ST": "state-v1",
    "CT": "control-v1#ChannelTestCommand", "CS": "control-v1#ChannelTestStop", "TE": "state-v1#TelemetrySample"
  },
  "cases": [
    { "id": "V01", "category": "version", "base": "P", "set": { "/schemaVersion": 2 }, "expect": "version.unsupportedMajor", "doc": "Version majeure de profil inconnue." },
    { "id": "V02", "category": "version", "base": "P", "set": { "/schemaVersion": 0 }, "expect": "version.unsupportedMajor", "doc": "Version 0 : un document v0 n'a pas de schemaVersion et passe par la migration." },
    { "id": "V03", "category": "version", "base": "P", "set": { "/schemaVersion": "1" }, "expect": "version.invalid", "doc": "Version en chaîne." },
    { "id": "V04", "category": "version", "base": "P", "set": { "/schemaVersion": 1.0 }, "expect": "version.invalid", "doc": "1.0 n'est pas un entier littéral." },
    { "id": "V05", "category": "version", "base": "P", "remove": ["/schemaVersion"], "expect": "schema.required", "expectPath": "/schemaVersion", "doc": "Version absente." },
    { "id": "V06", "category": "version", "base": "RQA", "set": { "/apiMajor": 2 }, "expect": "version.unsupportedMajor", "doc": "IPC majeure inconnue." },
    { "id": "V07", "category": "version", "base": "CX", "set": { "/contractMajor": 2 }, "expect": "version.unsupportedMajor", "doc": "Enveloppe CAPX majeure inconnue." },
    { "id": "V08", "category": "version", "base": "ST", "set": { "/schemaVersion": 3 }, "expect": "version.unsupportedMajor", "doc": "État d'agent majeure inconnue." },
    { "id": "V09", "category": "version", "base": "CX", "set": { "/payload/schemaVersion": 2 }, "expect": "schema.const", "expectPath": "/payload/schemaVersion", "doc": "Charge utile CAPX de version inconnue." },
    { "id": "V10", "category": "version", "base": "RSC", "set": { "/result/apiMajor": 2 }, "expect": "schema.const", "doc": "Capacités annonçant une IPC majeure inconnue." },

    { "id": "S01", "category": "size", "base": "P", "padTo": 131073, "expect": "json.tooLarge", "doc": "Document de 128 Kio + 1 octet." },
    { "id": "S02", "category": "size", "raw": "[[[[[[[[[[[[[[[[[1]]]]]]]]]]]]]]]]]", "target": "profile-v1", "expect": "json.tooDeep", "doc": "Profondeur 17." },
    { "id": "S03", "category": "size", "base": "P", "set": { "/name": { "$repeat": ["n", 81] } }, "expect": "schema.maxLength", "doc": "Nom de 81 caractères." },
    { "id": "S04", "category": "size", "base": "P", "set": { "/description": { "$repeat": ["d", 501] } }, "expect": "schema.maxLength", "doc": "Description de 501 caractères." },
    { "id": "S05", "category": "size", "base": "P", "set": { "/name": "" }, "expect": "schema.minLength", "doc": "Nom vide." },
    { "id": "S06", "category": "size", "base": "RQA", "padTo": 131073, "expect": "json.tooLarge", "doc": "Trame IPC au-delà du plafond." },
    { "id": "S07", "category": "size", "base": "RSE", "set": { "/error/message": { "$repeat": ["m", 501] } }, "expect": "schema.maxLength", "doc": "Message d'erreur trop long." },
    { "id": "S08", "category": "size", "base": "ST", "padTo": 200000, "expect": "json.tooLarge", "doc": "État trop volumineux." },

    { "id": "F01", "category": "nonFinite", "base": "P", "replace": [["\"masterGainDb\": 0", "\"masterGainDb\": NaN"]], "expect": "json.nonFinite", "doc": "NaN." },
    { "id": "F02", "category": "nonFinite", "base": "P", "replace": [["\"ceilingDb\": -0.3", "\"ceilingDb\": Infinity"]], "expect": "json.nonFinite", "doc": "Infinity." },
    { "id": "F03", "category": "nonFinite", "base": "P", "replace": [["\"channelGainDb\": [0,", "\"channelGainDb\": [-Infinity,"]], "expect": "json.nonFinite", "doc": "-Infinity dans un tableau." },
    { "id": "F04", "category": "nonFinite", "base": "PN", "replace": [["\"lfeLowPassHz\": 120", "\"lfeLowPassHz\": 1e999"]], "expect": "json.nonFinite", "doc": "Débordement double vers l'infini." },
    { "id": "F05", "category": "nonFinite", "base": "ST", "replace": [["-12.5", "NaN"]], "expect": "json.nonFinite", "doc": "Crête NaN dans l'état." },
    { "id": "F06", "category": "nonFinite", "base": "CT", "replace": [["\"levelDb\": -30", "\"levelDb\": -1e400"]], "expect": "json.nonFinite", "doc": "Niveau de test -1e400." },

    { "id": "J01", "category": "json", "base": "P", "replace": [["\"revision\": 1,", "\"revision\": 1, \"revision\": 2,"]], "expect": "json.duplicateKey", "doc": "Clé dupliquée à la racine." },
    { "id": "J02", "category": "json", "base": "P", "replace": [["\"enabled\": true,", "\"enabled\": true, \"enabled\": false,"]], "expect": "json.duplicateKey", "doc": "Clé dupliquée imbriquée." },
    { "id": "J03", "category": "json", "base": "P", "prefixBom": true, "expect": "json.encoding", "doc": "BOM UTF-8." },
    { "id": "J04", "category": "json", "base": "P", "invalidUtf8": true, "expect": "json.encoding", "doc": "Octet 0xFF dans une chaîne." },
    { "id": "J05", "category": "json", "base": "P", "replace": [["\"revision\": 1,", "\"revision\": 1, \"name\": \"\\ud800\","]], "expect": "json.surrogate", "doc": "Demi-paire isolée." },
    { "id": "J06", "category": "json", "base": "P", "replace": [["\n}\n", "\n}\n{}"]], "expect": "json.syntax", "doc": "Contenu après la valeur." },
    { "id": "J07", "category": "json", "base": "P", "replace": [["\"revision\": 1,", "\"revision\": 1, // commentaire\n"]], "expect": "json.syntax", "doc": "Commentaire interdit." },

    { "id": "M01", "category": "mask", "base": "RQT", "set": { "/payload/channelBit": 3 }, "expect": "schema.enum", "doc": "Deux bits pour un test de canal." },
    { "id": "M02", "category": "mask", "base": "RQT", "set": { "/payload/channelBit": 16 }, "expect": "schema.enum", "doc": "BL absent de la sortie physique 0x60F." },
    { "id": "M03", "category": "mask", "base": "CT", "set": { "/channelBit": 2048 }, "expect": "schema.enum", "doc": "Bit inconnu 0x800." },
    { "id": "M04", "category": "mask", "base": "CT", "set": { "/channelBit": 0 }, "expect": "schema.enum", "doc": "Aucun bit." },
    { "id": "M05", "category": "mask", "base": "ST", "set": { "/negotiatedFormat/channelMask": 7 }, "expect": "schema.enum", "doc": "Layout inconnu 0x7." },
    { "id": "M06", "category": "mask", "base": "ST", "set": { "/negotiatedFormat/channelMask": 51, "/negotiatedFormat/channelCount": 4 }, "expect": "schema.enum", "doc": "Quad refusé explicitement." },
    { "id": "M07", "category": "mask", "base": "ST", "set": { "/negotiatedFormat/channelCount": 2 }, "expect": "semantic.maskChannelCount", "doc": "0x60F annoncé avec deux canaux." },
    { "id": "M08", "category": "mask", "base": "RSC", "set": { "/result/endpoints/0/physicalChannelMask": 63 }, "expect": "schema.const", "doc": "Masque physique ≠ 0x60F." },
    { "id": "M09", "category": "mask", "base": "ST", "set": { "/instances/0/inputFormat/channelMask": 2147483651 }, "expect": "schema.enum", "doc": "Bit 31 inconnu." },
    { "id": "M10", "category": "mask", "base": "P", "set": { "/inputMask": 3 }, "expect": "schema.additionalProperties", "doc": "Masque v0 interdit dans un profil v1." },
    { "id": "M11", "category": "mask", "base": "ST", "set": { "/negotiatedFormat/channelMask": 1599, "/negotiatedFormat/channelCount": 8 }, "expect": "schema.enum", "doc": "7.1 jamais accepté en identité implicite." },

    { "id": "A01", "category": "array", "base": "P", "set": { "/output/channelGainDb": [0, 0, 0, 0, 0, 0] }, "expect": "schema.minItems", "doc": "Six positions au lieu de huit cases Channel." },
    { "id": "A02", "category": "array", "base": "P", "set": { "/output/channelGainDb/-": 0 }, "expect": "schema.maxItems", "doc": "Neuf cases." },
    { "id": "A03", "category": "array", "base": "P", "set": { "/output/channelMute/2": 0 }, "expect": "schema.type", "doc": "Nombre dans un tableau de booléens." },
    { "id": "A04", "category": "array", "base": "PF", "remove": ["/output/eq/3/9"], "expect": "schema.minItems", "expectPath": "/output/eq/3", "doc": "Neuf bandes sur un canal." },
    { "id": "A05", "category": "array", "base": "PF", "remove": ["/output/eq/7"], "expect": "schema.minItems", "expectPath": "/output/eq", "doc": "Sept canaux d'EQ." },
    { "id": "A06", "category": "array", "base": "P", "set": { "/output/channelDelayMs/1": "0" }, "expect": "schema.type", "doc": "Chaîne dans un tableau de délais." },
    { "id": "A07", "category": "array", "base": "ST", "set": { "/meters/outputPeakDbfs/-": -20 }, "expect": "schema.maxItems", "doc": "Sept crêtes physiques." },
    { "id": "A08", "category": "array", "base": "RSC", "set": { "/result/endpoints/0/supportedSampleRates": [48000, 48000] }, "expect": "schema.uniqueItems", "doc": "Fréquence dupliquée." },
    { "id": "A09", "category": "array", "base": "ST", "set": { "/instances/1/instanceId": "sfx-0" }, "expect": "semantic.duplicateInstance", "doc": "Instance dupliquée." },
    { "id": "A10", "category": "array", "base": "P", "set": { "/output/channelGainDb": { "FL": 0 } }, "expect": "schema.type", "doc": "Objet au lieu d'un tableau." },
    { "id": "A11", "category": "array", "base": "RSC", "set": { "/result/endpoints/0/supportedSampleRates": [48000, 88200] }, "expect": "schema.enum", "doc": "88,2 kHz jamais annoncé sur le rendu Xonar." },
    { "id": "A12", "category": "array", "base": "TE", "remove": ["/outputPeakDbfs/5"], "expect": "schema.minItems", "doc": "Télémétrie à cinq crêtes." },

    { "id": "Q01", "category": "nyquist", "base": "PF", "context": { "sampleRate": 32000 }, "expect": "semantic.nyquist", "doc": "Bandes 16 kHz et plus à 32 kHz." },
    { "id": "Q02", "category": "nyquist", "base": "PN", "set": { "/output/eq/0/0/frequencyHz": 4000 }, "context": { "sampleRate": 8000 }, "expect": "semantic.nyquist", "expectPath": "/output/eq/0/0/frequencyHz", "doc": "Fréquence égale à Nyquist : strictement sous Nyquist exigé." },
    { "id": "Q03", "category": "nyquist", "base": "PN", "set": { "/output/eq/2/5": { "enabled": false, "frequencyHz": 12000, "q": 1, "gainDb": 0 } }, "context": { "sampleRate": 22050 }, "expect": "semantic.nyquist", "doc": "Bande désactivée également contrôlée." },
    { "id": "Q04", "category": "nyquist", "base": "PN", "set": { "/output/eq/0/0/frequencyHz": 20001 }, "expect": "schema.maximum", "doc": "Borne statique 20 kHz." },
    { "id": "Q05", "category": "nyquist", "base": "PN", "set": { "/output/eq/0/0/frequencyHz": 9.5 }, "expect": "schema.minimum", "doc": "Sous 10 Hz." },
    { "id": "Q06", "category": "nyquist", "base": "CT", "set": { "/frequencyHz": 12000 }, "context": { "sampleRate": 22050 }, "expect": "semantic.nyquist", "doc": "Test de canal au-delà de Nyquist." },
    { "id": "Q07", "category": "nyquist", "base": "P", "context": { "sampleRate": 4000 }, "expect": "semantic.sampleRateRange", "doc": "Fréquence de connexion hors plage DSP." },
    { "id": "Q08", "category": "nyquist", "base": "P", "set": { "/output/bassManagement/crossoverHz": 201 }, "expect": "schema.maximum", "doc": "Crossover au-delà de 200 Hz." },
