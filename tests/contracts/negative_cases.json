    { "id": "R12", "category": "revision", "base": "ST", "set": { "/instances/0/appliedGeneration": 11 }, "expect": "semantic.partiallyAppliedMismatch", "doc": "Divergence non signalée." },
    { "id": "R13", "category": "revision", "base": "RSA", "set": { "/appliedInstances/1/appliedGeneration": 12 }, "expect": "semantic.appliedStatusMismatch", "doc": "Applied avec une instance en retard." },
    { "id": "R14", "category": "revision", "base": "RSA", "set": { "/desiredGeneration": 12 }, "expect": "semantic.generationOrder", "doc": "Réponse committed > desired." },
    { "id": "R15", "category": "revision", "base": "CT", "set": { "/generation": 0 }, "expect": "schema.minimum", "doc": "Génération de test 0." },
