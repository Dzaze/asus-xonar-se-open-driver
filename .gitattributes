# Normalisation des fins de ligne
* text=auto eol=lf

# Scripts PowerShell et fichiers INF conservent CRLF
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.inf text eol=crlf
*.inx text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaires
*.wav binary
*.png binary
*.jpg binary
*.ico binary
*.zip binary
*.7z binary
*.msi binary
*.sys binary
*.dll binary
*.cat binary
*.exe binary
*.pdb binary
