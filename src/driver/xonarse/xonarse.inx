KSNAME_WaveSpeaker="WaveSpeaker"
KSNAME_TopologySpeaker="TopologySpeaker"
KSNAME_WaveHeadphone="WaveHeadphone"
KSNAME_TopologyHeadphone="TopologyHeadphone"
